---
import "../styles/global.css";
import "../styles/footer.css";
import { Font } from "astro:assets";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import { getAlternatePath, siteConfig } from "../config/site";
import type { Locale } from "../types/ui";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  path?: string;
  image?: string;
}

const {
  title,
  description,
  locale = "es",
  path = "",
  image = "/og/home-hero-v2.png",
} = Astro.props;

const site = import.meta.env.PUBLIC_SITE_URL || siteConfig.defaultUrl;
const publicEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || siteConfig.defaultEmail;
const cleanPath = path ? `/${path.replace(/^\//, "")}` : locale === "en" ? "/en" : "/";
const alternatePath = getAlternatePath(cleanPath, locale);
const canonical = new URL(cleanPath, site).toString();
const alternate = new URL(alternatePath, site).toString();
const fullTitle = `${title} | ${siteConfig.name}`;
const socialImage = new URL(image, site).toString();
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${site.replace(/\/$/, "")}/#business`,
  name: siteConfig.name,
  description: "Evaluamos cómo opera tu empresa y diseñamos automatizaciones, agentes de IA y software que mejoran la productividad.",
  url: site,
  email: publicEmail,
  logo: new URL("/brand/logo-mark-512.png", site).toString(),
  founder: {
    "@type": "Person",
    name: siteConfig.founder.name,
    jobTitle: siteConfig.founder.roleEs,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Puerto Plata",
    addressCountry: "DO",
  },
  areaServed: ["DO", "US", "Worldwide"],
  sameAs: [
    siteConfig.social.instagram,
    siteConfig.social.facebook,
    siteConfig.social.x,
    siteConfig.founder.linkedIn,
  ],
};
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content={siteConfig.founder.name} />
  <meta name="creator" content={siteConfig.name} />
  <meta name="publisher" content={siteConfig.name} />
  <meta name="robots" content="index,follow" />
  <meta name="theme-color" content="#082F49" />
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={locale === "es" ? "en" : "es"} href={alternate} />
  <link rel="alternate" hreflang={locale} href={canonical} />
  <link rel="alternate" hreflang="x-default" href={new URL("/", site).toString()} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteConfig.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:locale" content={locale === "es" ? "es_DO" : "en_US"} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  <Font cssVariable="--astro-font-poppins" preload={[{ weight: 800, style: "normal", subset: "latin" }]} />
  <Font cssVariable="--astro-font-inter" />
  <Font cssVariable="--astro-font-jetbrains" />
  <style is:inline>
    :root {
      --font-sans: var(--astro-font-inter);
      --font-display: var(--astro-font-poppins);
      --font-mono: var(--astro-font-jetbrains);
    }
  </style>
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd).replace(/</g, "\\u003c")} />
</head>
<body>
  <a class="skip-link" href="#content">{locale === "es" ? "Saltar al contenido" : "Skip to content"}</a>
  <Navbar locale={locale} currentPath={cleanPath} alternatePath={alternatePath} />
  <main id="content"><slot /></main>
  <Footer locale={locale} publicEmail={publicEmail} />
  <script src="/umami-loader.js" defer fetchpriority="low"></script>
  <script src="/site-analytics.js" defer fetchpriority="low"></script>
  <script src="/site-motion.js" defer fetchpriority="low"></script>
</body>
</html>
