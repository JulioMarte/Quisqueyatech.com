{
  "name": "quisqueyatech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "api:start": "tsx scripts/api-server.ts",
    "worker:start": "tsx scripts/runtime-worker.ts",
    "db:migrate": "node scripts/sqlite-migrate.mjs",
    "db:migrate:auth": "tsx scripts/auth-migrate.ts",
    "db:import:convex": "node scripts/import-convex-snapshot.mjs",
    "test:sqlite": "node --test tests/sqlite/*.test.mjs && tsx --test tests/sqlite/*.test.ts",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','.astro']) fs.rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@astrojs/react": "6.0.2",
    "@lucide/astro": "1.24.0",
    "astro": "7.1.6",
    "better-auth": "1.6.23",
    "lucide-react": "1.24.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
