PUBLIC_SITE_URL=https://www.quisqueyatech.com
PUBLIC_CONTACT_EMAIL=info@quisqueyatech.com

# Public stable URLs only. Never place LiveKit API keys or secrets here.
PUBLIC_LIVEKIT_ASSESSMENT_URL=
PUBLIC_ASSESSMENT_SCHEDULE_URL=

# Umami analytics. These values are public tracker configuration and are embedded at build time.
# Production defaults are also built into BaseLayout for quisqueyatech.com/www only.
# Preview/staging should use a separate Website ID or leave these unset so production analytics stay clean.
PUBLIC_UMAMI_SCRIPT_URL=https://umami.quisqueyatech.com/script.js
PUBLIC_UMAMI_WEBSITE_ID=925defd4-10b8-4cc9-99ea-e7a271967e56
PUBLIC_UMAMI_DOMAINS=quisqueyatech.com,www.quisqueyatech.com
# Optional. Use when the tracker script and collection host differ.
PUBLIC_UMAMI_HOST_URL=

# SQLite runtime. These values are server-only; never rename them to PUBLIC_*.
SQLITE_DATABASE_PATH=./data/quisqueyatech.sqlite
SQLITE_MEDIA_OUTPUT_PATH=./public/uploads
API_PORT=8787
BETTER_AUTH_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=
ADMIN_API_SECRET=
ADMIN_SETUP_CODE=
CONFIG_ENCRYPTION_KEY=

# Browser origins that may call Better Auth / public API routes cross-origin.
AUTH_TRUSTED_ORIGINS=http://localhost:4221

# Cloudflare Turnstile protects public booking/assessment-start surfaces.
# Production must provide the real secret. Development uses Cloudflare's documented test secret when unset.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Optional authoritative client-IP headers supplied by a trusted reverse proxy.
# Leave blank until the proxy is configured to overwrite/sanitize them. The API falls back to socket.remoteAddress.
# Example only after verification: TRUSTED_CLIENT_IP_HEADERS=cf-connecting-ip,x-real-ip
TRUSTED_CLIENT_IP_HEADERS=
