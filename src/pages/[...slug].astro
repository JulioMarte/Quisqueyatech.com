---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pages, type StaticPage } from "../data/pages";
export function getStaticPaths(){return pages.map(page=>({params:{slug:page.path},props:{page}}));}
const {page}=Astro.props as {page:StaticPage};
const isEn=page.locale==="en";
const nowPath=isEn?"/en/assessment/now":"/evaluacion/ahora";
const schedulePath=isEn?"/en/assessment/schedule":"/evaluacion/agendar";
const livekit=import.meta.env.PUBLIC_LIVEKIT_ASSESSMENT_URL||"";
const schedule=import.meta.env.PUBLIC_ASSESSMENT_SCHEDULE_URL||"";
const privacy=isEn?[
["Data we collect","Assessment and booking flows may collect your name, company, role, country, email, mobile number, scheduling preferences, voice recording, transcript, and generated assessment."],
["Voice and retention","Recording requires explicit consent. Audio is retained for up to 30 days, full transcripts for 90 days, and lead summaries for up to 12 months unless an active commercial relationship or deletion request applies."],
["How we use data","We use this information to provide the assessment, manage appointments, contact you, improve service quality, and propose relevant work. We do not sell personal information."],
["Service providers","We may use infrastructure, database, email, scheduling, telephony, anti-abuse, and voice AI providers solely to deliver the service."]
]:[
["Datos que recopilamos","La evaluación y la agenda pueden recopilar nombre, empresa, cargo, país, correo, celular, preferencias de horario, grabación de voz, transcripción y evaluación generada."],
["Voz y retención","La grabación requiere consentimiento expreso. El audio se conserva hasta 30 días, la transcripción completa 90 días y el resumen del lead hasta 12 meses, salvo relación comercial activa o solicitud de eliminación."],
["Uso de la información","Usamos estos datos para entregar la evaluación, gestionar citas, contactarte, mejorar el servicio y proponer trabajo relevante. No vendemos información personal."],
["Proveedores","Podemos utilizar proveedores de infraestructura, base de datos, correo, agenda, telefonía, protección contra abuso e IA de voz únicamente para prestar el servicio."]
];
---
<BaseLayout title={page.title} description={page.lede} locale={page.locale} path={page.path} image={page.path.includes("clinics")||page.path.includes("clinicas")?"/og/clinicas.png":"/og/home.png"}>
<section class="page-hero"><div class="container"><span class="eyebrow">{page.eyebrow}</span><h1>{page.title}</h1><p class="lede">{page.lede}</p></div></section>
{page.kind==="assessment"?<section class="section"><div class="container choice-grid"><a class="card" href={nowPath}><div class="icon">◉</div><h3>{isEn?"Start now":"Hacerla ahora"}</h3><p>{isEn?"Speak with the agent from your browser and receive the summary when finished.":"Habla con el agente desde tu navegador y recibe el resumen al terminar."}</p><p class="card-action">{isEn?"Start assessment →":"Comenzar evaluación →"}</p></a><a class="card" href={schedulePath}><div class="icon">◷</div><h3>{isEn?"Reserve a time":"Reservar un horario"}</h3><p>{isEn?"Choose a time and complete the same assessment when convenient.":"Elige un horario y realiza la misma evaluación cuando te convenga."}</p><p class="card-action">{isEn?"View availability →":"Ver disponibilidad →"}</p></a></div></section>:null}
{page.kind==="livekit"?<section class="section"><div class="container"><div class="livekit-slot"><strong>{isEn?"LiveKit invitation":"Invitación de LiveKit"}</strong><p>{isEn?"The public website remains fully static. The voice session runs outside this website and opens through a public invitation link.":"El sitio público permanece completamente estático. La sesión de voz vive fuera de este sitio y se abre mediante un enlace público de invitación."}</p>{(page.path.endsWith("agendar")||page.path.endsWith("schedule"))?(schedule?<a class="btn" href={schedule} target="_blank" rel="noopener">{isEn?"View availability":"Ver disponibilidad"} →</a>:<p class="config-note">PUBLIC_ASSESSMENT_SCHEDULE_URL</p>):(livekit?<a class="btn" href={livekit} target="_blank" rel="noopener">{isEn?"Open assessment":"Abrir evaluación"} →</a>:<p class="config-note">PUBLIC_LIVEKIT_ASSESSMENT_URL</p>)}</div></div></section>:null}
{page.kind==="about"?<section class="section"><div class="container founder"><img src="/team/julio-marte.jpeg" alt="Julio Alberto Marte Balbuena"/><div><span class="eyebrow">{isEn?"Direct accountability":"Responsabilidad directa"}</span><h2>Julio Alberto Marte Balbuena</h2><p>{isEn?"Julio leads assessments, solution design, and each client relationship. QuisqueyaTech works from the Dominican Republic with companies at home and abroad.":"Julio lidera las evaluaciones, el diseño de soluciones y la relación con cada empresa. QuisqueyaTech trabaja desde República Dominicana con empresas dentro y fuera del país."}</p><p>{isEn?"Founder and automation & AI consultant":"Fundador y consultor de automatización e IA"}</p></div></div></section>:null}
{page.kind==="privacy"?<section class="section"><div class="container privacy-copy">{privacy.map(([title,body])=><section><h2>{title}</h2><p>{body}</p></section>)}<section><h2>{isEn?"Contact and deletion":"Contacto y eliminación"}</h2><p>{isEn?"To request access or deletion, email":"Para solicitar acceso o eliminación, escribe a"} <a href="mailto:info@quisqueyatech.com">info@quisqueyatech.com</a>.</p></section></div></section>:null}
{page.kind==="resources"?<section class="section"><div class="container"><div class="card"><h3>{isEn?"Resources":"Recursos"}</h3><p>{isEn?"Published resource articles are being moved to a build-time static content source so this site does not need a database runtime.":"Los artículos publicados se moverán a una fuente de contenido estática disponible durante el build para que este sitio no necesite una base de datos en tiempo de ejecución."}</p></div></div></section>:null}
{page.kind==="standard"&&page.points?.length?<section class="section"><div class="container"><div class="grid">{page.points.map(([title,body],i)=><article class="card"><div class="icon">0{i+1}</div><h3>{title}</h3><p>{body}</p></article>)}</div><div class="inline-cta"><h2>{isEn?"Start by understanding what is worth solving first.":"Empieza por entender qué conviene resolver primero."}</h2><div class="actions"><a class="btn" href={nowPath}>{isEn?"Start my assessment":"Quiero mi evaluación ahora"}</a><a class="btn outline" href={schedulePath}>{isEn?"Schedule my assessment":"Agendar mi evaluación"}</a></div></div></div></section>:null}
</BaseLayout>
