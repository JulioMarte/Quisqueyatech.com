---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/marketing.css";
import { pages, type StaticPage } from "../data/pages";
import StandardMarketingPage from "../components/pages/StandardMarketingPage.astro";
import AssessmentLanding from "../components/pages/AssessmentLanding.astro";
import { LiveAssessment } from "../components/react/pages/LiveAssessment";
import { ScheduleAssessment } from "../components/react/pages/ScheduleAssessment";
import { AboutSection } from "../components/react/pages/AboutSection";
import { PrivacyPolicy } from "../components/react/pages/PrivacyPolicy";
import { ResourcesLanding } from "../components/react/pages/ResourcesLanding";

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.path }, props: { page } }));
}

interface Props { page: StaticPage }
const { page } = Astro.props;
const isSchedule = page.kind === "livekit" && (page.path.endsWith("agendar") || page.path.endsWith("schedule"));
const pageImage = page.path.includes("clinics") || page.path.includes("clinicas") ? "/og/clinicas.png" : "/og/home.png";
const livekitUrl = import.meta.env.PUBLIC_LIVEKIT_ASSESSMENT_URL || "";
const scheduleUrl = import.meta.env.PUBLIC_ASSESSMENT_SCHEDULE_URL || "";
---
<BaseLayout title={page.title} description={page.lede} locale={page.locale} path={page.path} image={pageImage}>
  {page.kind === "standard" && <StandardMarketingPage page={page} />}
  {page.kind === "assessment" && <AssessmentLanding page={page} />}
  {page.kind === "livekit" && !isSchedule && <LiveAssessment locale={page.locale} livekitUrl={livekitUrl} />}
  {isSchedule && <ScheduleAssessment locale={page.locale} scheduleUrl={scheduleUrl} />}
  {page.kind === "about" && <AboutSection locale={page.locale} />}
  {page.kind === "privacy" && <PrivacyPolicy locale={page.locale} />}
  {page.kind === "resources" && <ResourcesLanding locale={page.locale} />}
</BaseLayout>
