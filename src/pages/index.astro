---
import BaseLayout from "../layouts/BaseLayout.astro";
const problems=[
  ["Trabajo manual que se multiplica","Datos copiados entre formularios, hojas de cálculo y sistemas que nunca se sincronizan."],
  ["Seguimientos que dependen de memoria","Solicitudes, clientes y tareas importantes quedan sin un próximo paso visible."],
  ["Información difícil de convertir en decisiones","Los reportes llegan tarde o requieren horas de preparación manual."]
];
const solutions=[
  ["Automatización de procesos","Conecta tareas repetitivas, aprobaciones, seguimiento y reportes para que el trabajo avance sin persecución constante.","/soluciones/automatizacion"],
  ["Agentes de IA","Agentes de voz o texto que recopilan información, atienden solicitudes y ejecutan tareas con límites definidos.","/soluciones/agentes-de-ia"],
  ["Software e integraciones","Aplicaciones e integraciones que unen los datos y herramientas que tu empresa ya utiliza.","/soluciones/software-e-integraciones"]
];
const steps=[["01","Evaluar","Identificamos procesos, fricción, herramientas y prioridades."],["02","Priorizar","Separamos oportunidades reales de ideas que todavía no justifican inversión."],["03","Diseñar","Definimos el flujo, los controles y la tecnología necesaria."],["04","Implementar","Construimos, probamos, capacitamos y medimos con uso real."]];
---
<BaseLayout title="Automatización, IA y software para empresas" description="Evaluamos cómo opera tu equipo, detectamos dónde se pierde tiempo y diseñamos automatizaciones, agentes de IA y software que mejoran la productividad sin complicar la operación." locale="es" path="">
<section class="hero-orchestration">
  <div class="dawn-stage" aria-hidden="true"><div class="dawn-halo dawn-halo-amber"></div><div class="dawn-halo dawn-halo-larimar"></div><div class="dawn-beam"></div><div class="dawn-grain"></div></div>
  <div class="container">
    <div class="hero-support" style="--hero-delay:.02s"><span class="eyebrow">Automatización, IA y software para empresas</span></div>
    <h1 class="kinetic-heading" aria-label="Tu empresa no necesita más herramientas. Necesita que trabajen juntas.">
      <span class="kinetic-mask"><span class="kinetic-primary">Tu empresa no necesita más herramientas.</span></span>
      <span class="kinetic-secondary" aria-hidden="true"><span class="kinetic-mask"><span class="kinetic-word" style="--word-index:0;--word-direction:-1">Necesita</span></span><span class="kinetic-mask"><span class="kinetic-word" style="--word-index:1;--word-direction:1">que</span></span><span class="kinetic-mask"><span class="kinetic-word" style="--word-index:2;--word-direction:-1">trabajen</span></span><span class="kinetic-mask"><span class="kinetic-word" style="--word-index:3;--word-direction:1">juntas.</span></span></span>
    </h1>
    <p class="hero-lede hero-support" style="--hero-delay:.6s">Evaluamos cómo opera tu equipo, detectamos dónde se pierde tiempo y diseñamos automatizaciones, agentes de IA y software que mejoran la productividad sin complicar la operación.</p>
    <div class="hero-actions hero-support" style="--hero-delay:.72s"><a class="button button-primary button-lg" href="/evaluacion/ahora"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 10a7 7 0 0 0 14 0M12 17v5M8 22h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Quiero mi evaluación ahora</a><a class="button button-outline" href="/evaluacion/agendar"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Agendar mi evaluación</a></div>
    <div class="hero-notes hero-support" style="--hero-delay:.82s">{["Evaluación inicial sin costo","Disponible en español e inglés","Resumen preliminar inmediato"].map(note=><span class="hero-note"><svg class="check-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{note}</span>)}</div>
    <div class="system-flow" aria-hidden="true">
      <svg class="system-flow-lines" viewBox="0 0 1000 150" preserveAspectRatio="none"><path d="M110 28 C160 95 360 84 500 124"/><path d="M500 28 C500 68 500 88 500 124"/><path d="M890 28 C840 95 640 84 500 124"/><circle class="flow-signal flow-signal-amber" r="5"><animateMotion dur="5.8s" begin="1.25s" repeatCount="indefinite" path="M110 28 C160 95 360 84 500 124"/></circle><circle class="flow-signal flow-signal-blue" r="5"><animateMotion dur="5.8s" begin="2.7s" repeatCount="indefinite" path="M500 28 C500 68 500 88 500 124"/></circle><circle class="flow-signal flow-signal-amber" r="5"><animateMotion dur="5.8s" begin="4.1s" repeatCount="indefinite" path="M890 28 C840 95 640 84 500 124"/></circle></svg>
      <div class="system-flow-sources"><span class="system-node system-node-source"><svg viewBox="0 0 24 24"><path d="M4 6h6v5H4zM14 13h6v5h-6zM10 8.5h4M12 8.5V15h2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>Automatización</span><span class="system-node system-node-source"><svg viewBox="0 0 24 24"><rect x="5" y="7" width="14" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 12h.01M15 12h.01M9 15h6M12 7V4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>Agentes de IA</span><span class="system-node system-node-source"><svg viewBox="0 0 24 24"><path d="m8 4-5 8 5 8M16 4l5 8-5 8M14 3l-4 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>Software</span></div><span class="system-node system-node-output">Un solo sistema</span>
    </div>
  </div>
</section>
<section class="section"><div class="container"><div class="section-head"><span class="eyebrow">El problema no es la falta de tecnología</span><h2>El trabajo se frena cuando procesos, personas y herramientas operan por separado.</h2><p>No recomendamos software por moda. Buscamos dónde se repite trabajo, se pierde información o una decisión llega demasiado tarde.</p></div><div class="home-grid">{problems.map(([title,body],i)=><article class="interactive-card"><div class="card-icon">{i===0?<svg viewBox="0 0 24 24"><path d="M4 7h6v5H4zM14 12h6v5h-6zM10 9.5h4M12 9.5v5h2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>:i===1?<svg viewBox="0 0 24 24"><path d="M5 6h14M5 12h9M5 18h6M17 12l2 2-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>:<svg viewBox="0 0 24 24"><path d="M4 18V9M10 18V5M16 18v-7M22 18H2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>}</div><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
<section class="section section-alt"><div class="container"><div class="section-head"><span class="eyebrow">Soluciones</span><h2>Tecnología aplicada a un resultado operativo claro.</h2><p>Podemos empezar con una mejora puntual o diseñar un sistema por fases. La herramienta se elige después de entender el proceso.</p></div><div class="home-grid">{solutions.map(([title,body,href],i)=><a class="interactive-card" href={href}><div class="card-icon dark-icon">{i===0?<svg viewBox="0 0 24 24"><path d="M4 7h6v5H4zM14 12h6v5h-6zM10 9.5h4M12 9.5v5h2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>:i===1?<svg viewBox="0 0 24 24"><rect x="5" y="7" width="14" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 12h.01M15 12h.01M12 7V4" stroke="currentColor" stroke-width="1.8"/></svg>:<svg viewBox="0 0 24 24"><path d="m8 4-5 8 5 8M16 4l5 8-5 8M14 3l-4 18" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>}</div><h3>{title}</h3><p>{body}</p><span class="card-link">Explorar solución →</span></a>)}</div></div></section>
<section class="section section-dark"><div class="container assessment-panel"><div class="assessment-copy"><span class="eyebrow dark">Empieza con claridad</span><h2>Una evaluación que también demuestra lo que podemos construir.</h2><p>Nuestro agente de voz realiza un levantamiento estructurado de 12–15 minutos. Al terminar recibes tres oportunidades preliminares, su impacto esperado y un próximo paso claro.</p><div class="hero-actions"><a class="button button-primary button-lg" href="/evaluacion/ahora">Quiero mi evaluación ahora</a><a class="button button-dark-outline" href="/evaluacion/agendar">Agendar mi evaluación</a></div></div><div class="voice-card"><div class="voice-title"><span><svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 0 1 16 0v5a2 2 0 0 1-2 2h-2v-7h4M4 12v7h4v-7H4z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span><div>Evaluación guiada por voz<br/><small>12–15 min · ES / EN</small></div></div><ul><li>Entiende tu proceso actual</li><li>Detecta trabajo repetitivo</li><li>Prioriza oportunidades</li><li>Entrega un resumen inmediato</li></ul></div></div></section>
<section class="section"><div class="container"><div class="section-head"><span class="eyebrow">Cómo trabajamos</span><h2>Primero entendemos. Después diseñamos. Finalmente implementamos.</h2></div><div class="steps">{steps.map(([n,t,p])=><article class="step"><span class="step-number">{n}</span><h3>{t}</h3><p>{p}</p></article>)}</div></div></section>
<section class="section section-alt"><div class="container founder"><img src="/team/julio-marte.jpeg" alt="Julio Alberto Marte Balbuena" loading="lazy"/><div class="section-head"><span class="eyebrow">Responsabilidad directa</span><h2>Una firma tecnológica con atención de fundador.</h2><p>Julio lidera las evaluaciones, el diseño de soluciones y la relación con cada empresa. QuisqueyaTech trabaja desde República Dominicana con empresas dentro y fuera del país.</p><p class="founder-name"><strong>Julio Alberto Marte Balbuena</strong><br/>Fundador y consultor de automatización e IA</p><div><a class="button button-outline" href="/nosotros">Conocer más</a></div></div></div></section>
<section class="section resources-cta"><div class="container"><div class="section-head"><span class="eyebrow">Recursos</span><h2>Recursos para tomar mejores decisiones tecnológicas</h2><p>Guías honestas sobre automatización, agentes de IA e integración de sistemas. Sin tendencias vacías ni promesas infladas.</p><div><a class="button button-outline" href="/recursos">Ver recursos</a></div></div></div></section>
<section class="section section-dark signature-cta"><div class="container"><h2>Descubre dónde la tecnología puede producir el mayor impacto.</h2><p>Completa la evaluación ahora o reserva el horario que te resulte más cómodo.</p><div class="hero-actions"><a class="button button-primary button-lg" href="/evaluacion/ahora">Quiero mi evaluación ahora</a><a class="button button-dark-outline" href="/evaluacion/agendar">Agendar mi evaluación</a></div></div></section>
</BaseLayout>