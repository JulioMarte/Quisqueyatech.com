---
import "../styles/global.css";
import { solutionLinks, type Locale } from "../data/pages";
interface Props { title:string; description:string; locale?:Locale; path?:string; image?:string; }
const { title, description, locale="es", path="", image="/og/home-hero-v2.png" } = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL || "https://www.quisqueyatech.com";
const publicEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || "info@quisqueyatech.com";
const cleanPath = path ? `/${path.replace(/^\//,"")}` : locale === "en" ? "/en" : "/";
const routePairs:Record<string,string>={"/":"/en","/soluciones":"/en/solutions","/soluciones/automatizacion":"/en/solutions/automation","/soluciones/agentes-de-ia":"/en/solutions/ai-agents","/soluciones/software-e-integraciones":"/en/solutions/software-and-integrations","/soluciones/clinicas":"/en/solutions/clinics","/como-trabajamos":"/en/how-we-work","/evaluacion":"/en/assessment","/evaluacion/ahora":"/en/assessment/now","/evaluacion/agendar":"/en/assessment/schedule","/recursos":"/en/recursos","/nosotros":"/en/about","/privacidad":"/en/privacy"};
const reverse=Object.fromEntries(Object.entries(routePairs).map(([es,en])=>[en,es]));
const other=routePairs[cleanPath]||reverse[cleanPath]||(locale==="en"?(cleanPath.replace(/^\/en(?=\/|$)/,"")||"/"):`/en${cleanPath}`);
const canonical=new URL(cleanPath,site).toString();
const alternate=new URL(other,site).toString();
const nav=locale==="es"?{solutions:"Soluciones",method:"Cómo trabajamos",resources:"Recursos",about:"Nosotros",assessment:"Quiero mi evaluación",all:"Ver todas las soluciones",company:"Empresa",contact:"Contacto",privacy:"Privacidad",lang:"Idioma"}:{solutions:"Solutions",method:"How we work",resources:"Resources",about:"About",assessment:"Get my assessment",all:"View all solutions",company:"Company",contact:"Contact",privacy:"Privacy",lang:"Language"};
const root=locale==="es"?"/":"/en";
const solutions=locale==="es"?"/soluciones":"/en/solutions";
const assessment=locale==="es"?"/evaluacion":"/en/assessment";
const links=[[locale==="es"?"/como-trabajamos":"/en/how-we-work",nav.method],[locale==="es"?"/recursos":"/en/recursos",nav.resources],[locale==="es"?"/nosotros":"/en/about",nav.about]];
const active=(href:string)=>cleanPath===href||cleanPath.startsWith(`${href}/`);
const fullTitle=`${title} | QuisqueyaTech`;
const descriptions=locale==="es"?["Reduce trabajo manual y errores repetidos.","Conversaciones y tareas con control humano.","Conecta herramientas y datos aislados.","Aplicaciones para recepción y seguimiento."]:["Reduce manual work and recurring errors.","Conversations and tasks with human oversight.","Connect isolated tools and data.","Applications for intake and follow-up."];
---
<!doctype html>
<html lang={locale}>
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#082F49"/>
<title>{fullTitle}</title><link rel="canonical" href={canonical}/><link rel="alternate" hreflang={locale==="es"?"en":"es"} href={alternate}/><link rel="alternate" hreflang={locale} href={canonical}/><link rel="alternate" hreflang="x-default" href={new URL("/",site).toString()}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="QuisqueyaTech"/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,site).toString()}/><meta property="og:locale" content={locale==="es"?"es_DO":"en_US"}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(image,site).toString()}/>
<link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png"/><link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
<a class="skip-link" href="#content">{locale==="es"?"Saltar al contenido":"Skip to content"}</a>
<header class="site-header">
  <div class="container nav-shell">
    <a class="brand-lockup" href={root} aria-label="QuisqueyaTech"><img src="/brand/logo-mark.png" width="40" height="40" alt=""/><span class="brand-name">QuisqueyaTech</span></a>
    <nav class="desktop-nav" aria-label={locale==="es"?"Principal":"Main"}>
      <div class:list={["nav-drop",active(solutions)&&"is-active"]}>
        <a class="nav-link solutions-trigger" href={solutions}>{nav.solutions}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="mega-menu"><div class="mega-grid">{solutionLinks[locale].map(([href,label],i)=><a class:list={["mega-item",active(href)&&"active"]} href={href}><strong>{label}</strong><span>{descriptions[i]}</span></a>)}</div><a class="mega-all" href={solutions}><span>{nav.all}</span><span>→</span></a></div>
      </div>
      {links.map(([href,label])=><a class:list={["nav-link",active(href)&&"is-active"]} href={href}>{label}</a>)}
    </nav>
    <div class="desktop-actions"><div class="language-switch" aria-label={nav.lang}>{locale==="es"?<><span aria-current="true">ES</span><a href={other} hreflang="en">EN</a></>:<><a href={other} hreflang="es">ES</a><span aria-current="true">EN</span></>}</div><a class="button button-primary" href={assessment}>{nav.assessment}</a></div>
    <button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu"><span class="menu-open">☰</span><span class="menu-close">×</span></button>
  </div>
  <div id="mobile-menu" class="mobile-menu"><div class="container mobile-menu-inner"><details><summary>{nav.solutions}<span>⌄</span></summary><div class="mobile-solutions">{solutionLinks[locale].map(([href,label])=><a href={href}>{label}</a>)}<a class="mobile-all" href={solutions}>{nav.all} →</a></div></details>{links.map(([href,label])=><a href={href}>{label}</a>)}<div class="mobile-divider"></div><div class="mobile-language"><small>{nav.lang}</small><div class="language-switch">{locale==="es"?<><span>ES</span><a href={other}>EN</a></>:<><a href={other}>ES</a><span>EN</span></>}</div></div><a class="button button-primary mobile-cta" href={assessment}>{nav.assessment}</a></div></div>
</header>
<main id="content"><slot/></main>
<footer class="site-footer"><div class="container"><div class="footer-grid"><div><a class="brand-lockup footer-brand" href={root}><img src="/brand/logo-mark.png" width="40" height="40" alt=""/><span><strong>QuisqueyaTech</strong><small>Automatización, IA y software para empresas</small></span></a><p>{locale==="es"?"La tecnología correcta, trabajando como un solo sistema.":"The right technology, working as one system."}</p><p>República Dominicana · Servicio internacional</p></div><div><strong>{nav.solutions}</strong>{solutionLinks[locale].map(([href,label])=><p><a href={href}>{label}</a></p>)}</div><div><strong>{nav.company}</strong>{links.map(([href,label])=><p><a href={href}>{label}</a></p>)}<p><a href={locale==="es"?"/privacidad":"/en/privacy"}>{nav.privacy}</a></p></div><div><strong>{nav.contact}</strong><p><a href={`mailto:${publicEmail}`}>{publicEmail}</a></p><p>Puerto Plata, República Dominicana</p></div></div><div class="copyright">© {new Date().getFullYear()} QuisqueyaTech.</div></div></footer>
<script is:inline>
const button=document.querySelector('.mobile-toggle');const menu=document.querySelector('#mobile-menu');button?.addEventListener('click',()=>{const open=menu?.classList.toggle('open');button.setAttribute('aria-expanded',String(Boolean(open)));document.body.classList.toggle('menu-opened',Boolean(open));});document.querySelectorAll('#mobile-menu a').forEach(a=>a.addEventListener('click',()=>{menu?.classList.remove('open');button?.setAttribute('aria-expanded','false');document.body.classList.remove('menu-opened');}));
</script>
</body></html>