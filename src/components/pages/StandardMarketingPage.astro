---
import type { StaticPage } from "../../data/pages";
import { MarketingGrid } from "../react/marketing/MarketingGrid";
import { Button } from "../react/ui/Button";

interface Props { page: StaticPage }
const { page } = Astro.props;
const isEn = page.locale === "en";
const nowPath = isEn ? "/en/assessment/now" : "/evaluacion/ahora";
const schedulePath = isEn ? "/en/assessment/schedule" : "/evaluacion/agendar";
---
<section class="marketing-hero">
  <div class="container">
    <div class="motion-reveal">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.title}</h1>
      <p class="marketing-lede">{page.lede}</p>
    </div>
  </div>
</section>
<section class="section marketing-body">
  <div class="container">
    <MarketingGrid points={page.points ?? []} fourColumns={page.points?.length === 4} />
    <div class="marketing-cta motion-mask">
      <h2>{isEn ? "Start by understanding what is worth solving first." : "Empieza por entender qué conviene resolver primero."}</h2>
      <div class="hero-actions">
        <Button href={nowPath}>{isEn ? "Start my assessment" : "Quiero mi evaluación ahora"}</Button>
        <Button href={schedulePath} variant="dark-outline">{isEn ? "Schedule my assessment" : "Agendar mi evaluación"}</Button>
      </div>
    </div>
  </div>
</section>
