FROM node:22.20-alpine

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund

COPY db ./db
COPY scripts ./scripts
COPY src ./src
COPY tsconfig.json ./tsconfig.json

RUN mkdir -p /data /uploads \
  && chown -R node:node /app /data /uploads

ENV NODE_ENV=production \
    SQLITE_DATABASE_PATH=/data/quisqueyatech.sqlite \
    SQLITE_MEDIA_OUTPUT_PATH=/uploads \
    API_PORT=8787

USER node

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["npm", "run", "api:start"]
