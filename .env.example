PUBLIC_SITE_URL=https://www.quisqueyatech.com
PUBLIC_CONTACT_EMAIL=info@quisqueyatech.com

# Public stable URLs only. Never place LiveKit API keys or secrets here.
PUBLIC_LIVEKIT_ASSESSMENT_URL=
PUBLIC_ASSESSMENT_SCHEDULE_URL=

# Umami analytics. These values are public tracker configuration and are embedded at build time.
# Production defaults are also built into BaseLayout for quisqueyatech.com/www only.
# Preview/staging should use a separate Website ID or leave these unset so production analytics stay clean.
PUBLIC_UMAMI_SCRIPT_URL=https://umami.quisqueyatech.com/script.js
PUBLIC_UMAMI_WEBSITE_ID=925defd4-10b8-4cc9-99ea-e7a271967e56
PUBLIC_UMAMI_DOMAINS=quisqueyatech.com,www.quisqueyatech.com
# Optional. Use when the tracker script and collection host differ.
PUBLIC_UMAMI_HOST_URL=
