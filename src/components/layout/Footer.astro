---
import { localizedRoutes, siteConfig } from "../../config/site";
import type { Locale } from "../../types/ui";

interface Props {
  locale: Locale;
  publicEmail: string;
}

const { locale, publicEmail } = Astro.props;
const routes = localizedRoutes[locale];
const labels = locale === "es"
  ? { solutions: "Soluciones", company: "Compañía", contact: "Contacto", follow: "Síguenos", privacy: "Privacidad" }
  : { solutions: "Solutions", company: "Company", contact: "Contact", follow: "Follow us", privacy: "Privacy" };
const footerSolutions = locale === "es"
  ? [["/soluciones/automatizacion", "Automatización"], ["/soluciones/agentes-de-ia", "Agentes de IA"], ["/soluciones/software-e-integraciones", "Software e integraciones"]]
  : [["/en/solutions/automation", "Automation"], ["/en/solutions/ai-agents", "AI agents"], ["/en/solutions/software-and-integrations", "Software and integrations"]];
const footerCompany = [
  [routes.method, locale === "es" ? "Cómo trabajamos" : "How we work"],
  [routes.about, locale === "es" ? "Nosotros" : "About"],
  [routes.resources, locale === "es" ? "Recursos" : "Resources"],
] as const;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="footer-brand" href={routes.root}>
          <img src="/brand/logo-mark.png" width="40" height="40" alt=""/>
          <span><strong>{siteConfig.name}</strong><small>{siteConfig.descriptor}</small></span>
        </a>
        <p class="footer-intro">{locale === "es" ? "Automatización, agentes de IA y software para empresas que quieren operar con más claridad." : "Automation, AI agents, and software for companies that want clearer operations."}</p>
      </div>
      <div><h2 class="footer-group-title">{labels.solutions}</h2>{footerSolutions.map(([href, label]) => <a class="footer-link" href={href}>{label}</a>)}</div>
      <div><h2 class="footer-group-title">{labels.company}</h2>{footerCompany.map(([href, label]) => <a class="footer-link" href={href}>{label}</a>)}</div>
      <div>
        <h2 class="footer-group-title">{labels.contact}</h2>
        <a class="footer-link" href={`mailto:${publicEmail}`}>{publicEmail}</a>
        <span class="footer-location">{siteConfig.location}</span>
        <p class="footer-contact-note">{locale === "es" ? "Atención directa desde República Dominicana para proyectos locales e internacionales." : "Direct support from the Dominican Republic for local and international projects."}</p>
      </div>
      <div>
        <h2 class="footer-group-title">{labels.follow}</h2>
        <div class="social-grid">
          <a class="social-link" href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram de QuisqueyaTech"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg><span>Instagram</span></a>
          <a class="social-link" href={siteConfig.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook de QuisqueyaTech"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-3 0-5 2-5 5v2H6v4h3v5h4v-5h3l1-4h-4V9c0-.7.3-1 1-1Z" fill="currentColor"/></svg><span>Facebook</span></a>
          <a class="social-link" href={siteConfig.social.x} target="_blank" rel="noopener noreferrer" aria-label="X de QuisqueyaTech"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4l14 16M19 4 5 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span>X</span></a>
          <a class="social-link" href={siteConfig.founder.linkedIn} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de QuisqueyaTech"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="9" width="3" height="11" fill="currentColor"/><circle cx="5.5" cy="5.5" r="1.8" fill="currentColor"/><path d="M10 9h3v1.6c1-1.3 2.2-2 4-2 3 0 4 2 4 5.2V20h-3v-5.5c0-1.8-.6-2.8-2.1-2.8-1.7 0-2.9 1.2-2.9 3.4V20h-3Z" fill="currentColor"/></svg><span>LinkedIn</span></a>
        </div>
      </div>
    </div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {siteConfig.name} · {siteConfig.location}</span><a href={routes.privacy}>{labels.privacy}</a></div>
  </div>
</footer>
