---
import "../styles/global.css";
import { solutionLinks, type Locale } from "../data/pages";
interface Props { title:string; description:string; locale?:Locale; path?:string; }
const { title, description, locale="es", path="" } = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL || "https://www.quisqueyatech.com";
const canonical = new URL(`/${path}`, site).toString();
const other = locale === "es" ? (path ? `/en${path.startsWith("en/")?path.slice(2):""}` : "/en") : "/";
const nav = locale === "es" ? {solutions:"Soluciones",method:"Cómo trabajamos",resources:"Recursos",about:"Nosotros",assessment:"Evaluación"} : {solutions:"Solutions",method:"How we work",resources:"Resources",about:"About",assessment:"Assessment"};
const root = locale === "es" ? "/" : "/en";
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#082F49" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/icon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title} | QuisqueyaTech</title>
</head>
<body>
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={root} aria-label="QuisqueyaTech">Quisqueya<b>Tech</b></a>
    <nav class="nav-links" aria-label={locale === "es" ? "Principal" : "Main"}>
      <details class="drop"><summary>{nav.solutions} ▾</summary><div class="drop-menu">{solutionLinks[locale].map(([href,label]) => <a href={href}>{label}</a>)}</div></details>
      <a href={locale === "es" ? "/como-trabajamos" : "/en/how-we-work"}>{nav.method}</a>
      <a href={locale === "es" ? "/recursos" : "/en/recursos"}>{nav.resources}</a>
      <a href={locale === "es" ? "/nosotros" : "/en/about"}>{nav.about}</a>
      <a class="lang" href={other}>{locale === "es" ? "EN" : "ES"}</a>
      <a class="btn" href={locale === "es" ? "/evaluacion" : "/en/assessment"}>{nav.assessment}</a>
    </nav>
    <button class="mobile-toggle" aria-label="Menu" aria-expanded="false">☰</button>
  </div>
  <nav class="container mobile-nav"><a href={locale === "es" ? "/soluciones" : "/en/solutions"}>{nav.solutions}</a><a href={locale === "es" ? "/como-trabajamos" : "/en/how-we-work"}>{nav.method}</a><a href={locale === "es" ? "/recursos" : "/en/recursos"}>{nav.resources}</a><a href={locale === "es" ? "/nosotros" : "/en/about"}>{nav.about}</a><a href={locale === "es" ? "/en" : "/"}>{locale === "es" ? "English" : "Español"}</a></nav>
</header>
<main><slot /></main>
<footer class="site-footer"><div class="container"><div class="footer-grid"><div><div class="brand" style="color:white">Quisqueya<span style="color:#f97316">Tech</span></div><p>{locale === "es" ? "Automatización, IA y software para empresas." : "Automation, AI, and software for modern companies."}</p><p>Puerto Plata, República Dominicana · Servicio internacional</p></div><div><strong>{nav.solutions}</strong>{solutionLinks[locale].map(([href,label]) => <p><a href={href}>{label}</a></p>)}</div><div><strong>{locale === "es" ? "Contacto" : "Contact"}</strong><p><a href="mailto:info@quisqueyatech.com">info@quisqueyatech.com</a></p><p><a href={locale === "es" ? "/privacidad" : "/en/privacy"}>{locale === "es" ? "Privacidad" : "Privacy"}</a></p></div></div><div class="copyright">© {new Date().getFullYear()} QuisqueyaTech.</div></div></footer>
<script is:inline>
  const b=document.querySelector('.mobile-toggle'); const n=document.querySelector('.mobile-nav'); b?.addEventListener('click',()=>{const o=n?.classList.toggle('open');b.setAttribute('aria-expanded',String(Boolean(o)));});
  document.querySelectorAll('.drop a').forEach(a=>a.addEventListener('click',()=>a.closest('details')?.removeAttribute('open')));
</script>
</body></html>
