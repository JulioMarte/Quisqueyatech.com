---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pages, type StaticPage } from "../data/pages";
export function getStaticPaths(){ return pages.map(page=>({params:{slug:page.path},props:{page}})); }
const { page } = Astro.props as {page:StaticPage};
const isEn = page.locale === "en";
const livekit = import.meta.env.PUBLIC_LIVEKIT_ASSESSMENT_URL || "#livekit-invitation";
const schedule = import.meta.env.PUBLIC_ASSESSMENT_SCHEDULE_URL || livekit;
---
<BaseLayout title={page.title} description={page.lede} locale={page.locale} path={page.path}>
<section class="page-hero"><div class="container"><span class="eyebrow">{page.eyebrow}</span><h1>{page.title}</h1><p class="lede">{page.lede}</p></div></section>
{page.kind === "assessment" ? <section class="section"><div class="container choice-grid"><a class="card" href={livekit}><div class="icon">◉</div><h3>{isEn?"Start now":"Hacerla ahora"}</h3><p>{isEn?"Join the LiveKit room from your browser using an invitation link.":"Entra a la sala de LiveKit desde tu navegador mediante un enlace de invitación."}</p><p style="margin-top:18px;color:#c2410c;font-weight:800">{isEn?"Start assessment →":"Comenzar evaluación →"}</p></a><a class="card" href={schedule}><div class="icon">◷</div><h3>{isEn?"Reserve a time":"Reservar un horario"}</h3><p>{isEn?"Use the configured scheduler or LiveKit invitation workflow.":"Usa la agenda configurada o el flujo de invitación de LiveKit."}</p><p style="margin-top:18px;color:#c2410c;font-weight:800">{isEn?"Schedule →":"Agendar →"}</p></a></div></section> : null}
{page.kind === "livekit" ? <section class="section"><div class="container"><div class="livekit-slot" id="livekit-invitation"><strong>{isEn?"LiveKit integration point":"Punto de integración con LiveKit"}</strong><p>{isEn?"Set PUBLIC_LIVEKIT_ASSESSMENT_URL or PUBLIC_ASSESSMENT_SCHEDULE_URL during the static build. No voice-agent backend runs in this website.":"Define PUBLIC_LIVEKIT_ASSESSMENT_URL o PUBLIC_ASSESSMENT_SCHEDULE_URL durante el build estático. Este sitio no ejecuta backend del agente de voz."}</p><a class="btn" href={page.path.endsWith("agendar")||page.path.endsWith("schedule")?schedule:livekit}>{isEn?"Open invitation":"Abrir invitación"}</a></div></div></section> : null}
{page.kind === "about" ? <section class="section"><div class="container founder"><img src="/team/julio-marte.jpeg" alt="Julio Alberto Marte Balbuena" /><div><h2>Julio Alberto Marte Balbuena</h2><p>{isEn?"Founder and automation & AI consultant. Direct accountability from discovery through implementation.":"Fundador y consultor de automatización e IA. Responsabilidad directa desde el levantamiento hasta la implementación."}</p><p>Puerto Plata, República Dominicana · Servicio internacional</p></div></div></section> : null}
{page.kind === "privacy" ? <section class="section"><div class="container privacy-copy"><h2>{isEn?"Information we collect":"Información que recopilamos"}</h2><p>{isEn?"We collect only information you voluntarily provide through contact, assessment, scheduling, or external call tools.":"Recopilamos únicamente la información que compartes voluntariamente mediante contacto, evaluación, agenda o herramientas externas de llamadas."}</p><h2>{isEn?"External services":"Servicios externos"}</h2><p>{isEn?"Voice calls and invitations can be provided by LiveKit or another configured provider. Their own privacy terms apply to those services.":"Las llamadas de voz e invitaciones pueden ser provistas por LiveKit u otro proveedor configurado. Sus términos de privacidad aplican a esos servicios."}</p><h2>{isEn?"Contact":"Contacto"}</h2><p><a href="mailto:info@quisqueyatech.com">info@quisqueyatech.com</a></p></div></section> : null}
{page.kind === "resources" ? <section class="section"><div class="container"><div class="card"><h3>{isEn?"Static resource library":"Biblioteca estática de recursos"}</h3><p>{isEn?"Resource articles must now live in the repository or another build-time content source. The public site no longer queries Convex at request time.":"Los artículos deben vivir ahora en el repositorio o en otra fuente de contenido disponible durante el build. El sitio público ya no consulta Convex en cada petición."}</p></div></div></section> : null}
{page.kind === "standard" && page.points?.length ? <section class="section"><div class="container"><div class="grid">{page.points.map(([title,body],i)=><article class="card"><div class="icon">0{i+1}</div><h3>{title}</h3><p>{body}</p></article>)}</div><div class="actions" style="justify-content:flex-start;margin-top:34px"><a class="btn" href={isEn?"/en/assessment":"/evaluacion"}>{isEn?"Start with an assessment":"Empezar con una evaluación"}</a></div></div></section> : null}
</BaseLayout>
