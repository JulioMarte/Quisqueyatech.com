# Sitio público
NEXT_PUBLIC_SITE_URL=https://www.quisqueyatech.com
NEXT_PUBLIC_CONTACT_EMAIL=info@quisqueyatech.com

# Convex Cloud (npx convex dev completa los valores locales)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOY_KEY=

# Administración editorial (BETTER_AUTH_SECRET, SITE_URL y ADMIN_SETUP_CODE
# pertenecen al deployment de Convex Cloud; consulta README.md)
AUTH_IP_HASH_SECRET=
TRUST_PROXY_HEADERS=false
# Compatibilidad temporal para API keys de agentes y llamadas servicio-servicio.
ADMIN_API_SECRET=
# 32 bytes en base64 o 64 caracteres hexadecimales; no se administra desde el panel.
CONFIG_ENCRYPTION_KEY=
CONTENT_AI_PROVIDER=gemini
CONTENT_AI_MODEL=gemini-2.5-flash

# Evaluación de voz: ultravox | livekit | gemini-live
VOICE_PROVIDER=livekit
ULTRAVOX_API_KEY=
ULTRAVOX_MODEL=
ULTRAVOX_VOICE=
ULTRAVOX_WEBHOOK_SECRET=
LIVEKIT_URL=
LIVEKIT_AGENT_READY_TIMEOUT_MS=60000
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PROJECT_SUBDOMAIN=live-translate-r87y5gh3
ASSESSMENT_APP_URL=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede
GEMINI_LIVE_TEMPERATURE=0.3
ASSESSMENT_REPORT_MODEL=gemini-2.5-flash
ASSESSMENT_TOKEN_SECRET=
ASSESSMENT_STORAGE_SECRET=
ASSESSMENT_WORKER_SECRET=
ASSESSMENT_HEALTH_PROBE_TOKEN=
ASSESSMENT_DOCTOR_URL=

# Easy!Appointments (solo servidor)
EASY_APPOINTMENTS_URL=http://easyappointments
EASY_APPOINTMENTS_API_TOKEN=
EASY_APPOINTMENTS_WEBHOOK_TOKEN=
EASY_APPOINTMENTS_PROVIDER_ID=
EASY_APPOINTMENTS_SERVICE_ID=
EASY_APPOINTMENTS_TIMEZONE=America/Santo_Domingo

# Correo y telefonía
RESEND_API_KEY=
RESEND_FROM_EMAIL=QuisqueyaTech <evaluaciones@quisqueyatech.com>
LEAD_TO_EMAIL=juliomarte@quisqueyatech.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Protección contra abuso
# Solo produccion. npm run dev usa las claves de prueba oficiales de Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=quisqueyatech.com,www.quisqueyatech.com

# Despliegue secuencial
COOLIFY_WEBHOOK_URL=
COOLIFY_TOKEN=

# OpenTelemetry / observabilidad
# Define OTEL_ENABLED=false para desactivar el SDK sin cambiar el build.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=quisqueyatech-web
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_ENDPOINT=
# Opcional si quieres endpoints por señal como Grafana Cloud:
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# Ejemplo: Authorization=Bearer <token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
