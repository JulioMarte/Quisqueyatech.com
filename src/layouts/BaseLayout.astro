---
import "../styles/global.css";
import "../styles/footer.css";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import type { Locale } from "../types/ui";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  path?: string;
  image?: string;
}

const {
  title,
  description,
  locale = "es",
  path = "",
  image = "/og/home-hero-v2.png",
} = Astro.props;

const site = import.meta.env.PUBLIC_SITE_URL || "https://www.quisqueyatech.com";
const publicEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || "info@quisqueyatech.com";
const cleanPath = path ? `/${path.replace(/^\//, "")}` : locale === "en" ? "/en" : "/";
const routePairs: Record<string, string> = {
  "/": "/en",
  "/soluciones": "/en/solutions",
  "/soluciones/automatizacion": "/en/solutions/automation",
  "/soluciones/agentes-de-ia": "/en/solutions/ai-agents",
  "/soluciones/software-e-integraciones": "/en/solutions/software-and-integrations",
  "/soluciones/clinicas": "/en/solutions/clinics",
  "/como-trabajamos": "/en/how-we-work",
  "/evaluacion": "/en/assessment",
  "/evaluacion/ahora": "/en/assessment/now",
  "/evaluacion/agendar": "/en/assessment/schedule",
  "/recursos": "/en/recursos",
  "/nosotros": "/en/about",
  "/privacidad": "/en/privacy",
};
const reversePairs = Object.fromEntries(Object.entries(routePairs).map(([es, en]) => [en, es]));
const alternatePath = routePairs[cleanPath] || reversePairs[cleanPath] || (locale === "en" ? cleanPath.replace(/^\/en(?=\/|$)/, "") || "/" : `/en${cleanPath}`);
const canonical = new URL(cleanPath, site).toString();
const alternate = new URL(alternatePath, site).toString();
const fullTitle = `${title} | QuisqueyaTech`;
const socialImage = new URL(image, site).toString();
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${site.replace(/\/$/, "")}/#business`,
  name: "QuisqueyaTech",
  description: "Evaluamos cómo opera tu empresa y diseñamos automatizaciones, agentes de IA y software que mejoran la productividad.",
  url: site,
  email: publicEmail,
  logo: new URL("/brand/logo-mark-512.png", site).toString(),
  founder: {
    "@type": "Person",
    name: "Julio Alberto Marte Balbuena",
    jobTitle: "Fundador y consultor de automatización e IA",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Puerto Plata",
    addressCountry: "DO",
  },
  areaServed: ["DO", "US", "Worldwide"],
  sameAs: [
    "https://instagram.com/quisqueyait",
    "https://facebook.com/quisqueyait",
    "https://x.com/quisqueyait",
    "https://www.linkedin.com/in/julio-alberto-marte-balbuena-5454a072",
  ],
};
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content="Julio Alberto Marte Balbuena" />
  <meta name="creator" content="QuisqueyaTech" />
  <meta name="publisher" content="QuisqueyaTech" />
  <meta name="robots" content="index,follow" />
  <meta name="theme-color" content="#082F49" />
  <title>{fullTitle}</title>
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={locale === "es" ? "en" : "es"} href={alternate} />
  <link rel="alternate" hreflang={locale} href={canonical} />
  <link rel="alternate" hreflang="x-default" href={new URL("/", site).toString()} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="QuisqueyaTech" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:locale" content={locale === "es" ? "es_DO" : "en_US"} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd).replace(/</g, "\\u003c")} />
</head>
<body>
  <a class="skip-link" href="#content">{locale === "es" ? "Saltar al contenido" : "Skip to content"}</a>
  <Navbar locale={locale} currentPath={cleanPath} alternatePath={alternatePath} />
  <main id="content"><slot /></main>
  <Footer locale={locale} publicEmail={publicEmail} />
  <script src="/site-motion.js" defer></script>
</body>
</html>
